# Copy to .env and adjust. All settings are optional.
# MD_DATABASE_URL=postgresql+psycopg://modeldoctor:modeldoctor@localhost:5432/modeldoctor
# MD_DATA_DIR=./data
MD_MAX_UPLOAD_MB=50
MD_MAX_ROWS=1000000
MD_MAX_COLS=500
MD_MIN_ROWS=30
MD_CORS_ORIGINS=["http://localhost:3000"]

# AI assistant: auto | ollama | anthropic | rules (auto prefers local Ollama)
MD_ASSISTANT_MODE=auto
MD_OLLAMA_URL=http://127.0.0.1:11434
MD_OLLAMA_MODEL=llama3.1:latest
